{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Surf Engine",
	"version": "0.1.0",
	"identifier": "app.surf.desktop",
	"build": {
		"beforeDevCommand": { "script": "pnpm assemble", "wait": true },
		"beforeBuildCommand": "pnpm assemble",
		"frontendDist": "../splash"
	},
	"app": {
		"windows": [],
		"security": {
			"csp": "default-src 'self'; img-src 'self'; style-src 'self'; script-src 'self'"
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"category": "Productivity",
		"shortDescription": "Isolated, persistent Chrome profiles",
		"longDescription": "Surf Engine keeps isolated, persistent Chrome profiles with end-to-end encrypted sync and sharing, team workspaces, proxies, and automation for scripts and AI agents.",
		"externalBin": ["binaries/surf-node"],
		"resources": { "resources/app/": "app/" },
		"icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
		"macOS": { "entitlements": "Entitlements.plist", "minimumSystemVersion": "11.0" }
	},
	"plugins": {
		"updater": {
			"pubkey": "",
			"endpoints": ["https://github.com/SheikhAminul/surf-desktop/releases/latest/download/latest.json"],
			"windows": { "installMode": "passive" }
		}
	}
}
