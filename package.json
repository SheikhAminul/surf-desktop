{
	"name": "browsy-desktop",
	"version": "0.1.0",
	"private": true,
	"description": "Browsy as a desktop app: browsy-app in a native window, with its own Node.js runtime",
	"type": "module",
	"license": "UNLICENSED",
	"packageManager": "pnpm@12.15.0",
	"engines": {
		"node": ">=26"
	},
	"scripts": {
		"bootstrap": "node scripts/bootstrap.mjs",
		"assemble": "node scripts/assemble.ts",
		"dev": "tauri dev",
		"build": "tauri build",
		"tauri": "tauri",
		"typecheck": "tsc --noEmit",
		"lint": "biome check . && cargo fmt --manifest-path src-tauri/Cargo.toml --check",
		"format": "biome check --write . && cargo fmt --manifest-path src-tauri/Cargo.toml",
		"check": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.4",
		"@tauri-apps/cli": "^2.12.4",
		"@types/node": "^26.6.6",
		"esbuild": "^0.28.2",
		"typescript": "^7.0.2"
	}
}
